# FundRaiser Backend Configuration
# Copy this file to .env and update with your values

# Environment
APP_ENV=development
NODE_ENV=development

# Server
PORT=3000

# Database Configuration
# Example PostgreSQL connection string:
# postgresql://username:password@localhost:5432/football_pool
DATABASE_URL=postgresql://postgres:password@localhost:5432/football_pool

# Admin API Key - Set a strong random value for production!
# Used for admin endpoints like /api/admin/games/create
# Example: openssl rand -hex 32
FUNDRAISER_ADMIN_KEY=dev-secret-key-change-in-production

# Optional: JWT Configuration (if needed for future features)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Optional: Email Configuration (if adding notifications in future)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend Base URL (for CORS if frontend is separate)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
